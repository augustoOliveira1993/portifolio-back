{
  "Module DTO": {
    "prefix": "dto",
    "description": "Cria interface DTO com Document",
    "body": [
      "import { Document } from 'mongoose';",
      "",
      "export interface I${1:Resource}DTO {",
      "  ${2:name}: string;",
      "  ${3:description}?: string;",
      "  created_by?: string | null;",
      "  updated_by?: string | null;",
      "}",
      "",
      "export interface I${1:Resource}Document extends I${1:Resource}DTO, Document {}",
    ],
  },

  "Repository Interface": {
    "prefix": "repo-interface",
    "description": "Cria interface de repositório",
    "body": [
      "import { I${1:Resource}DTO, I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import IBaseRepository from '@shared/infra/database/mongo/IBaseRepository';",
      "",
      "export default interface I${1:Resource}Repository",
      "  extends IBaseRepository<I${1:Resource}DTO, I${1:Resource}Document> {",
      "  // Adicione métodos customizados aqui",
      "  ${3:// findByName(name: string): Promise<I${1:Resource}Document | null>;}",
      "}",
    ],
  },

  "Repository Implementation": {
    "prefix": "repo-impl",
    "description": "Cria implementação de repositório",
    "body": [
      "import { Model } from 'mongoose';",
      "import { ${1:Resource} } from '@modules/${2:moduleName}/infra/mongo/models/${1:Resource}';",
      "import { I${1:Resource}DTO, I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { BaseMongoRepository } from '@shared/infra/database/mongo/BaseMongoRepository';",
      "",
      "export default class ${1:Resource}Repository",
      "  extends BaseMongoRepository<I${1:Resource}DTO, I${1:Resource}Document>",
      "  implements I${1:Resource}Repository",
      "{",
      "  protected readonly model: Model<I${1:Resource}Document> = ${1:Resource};",
      "  protected readonly modelPopulated = [];",
      "",
      "  // Implemente métodos customizados aqui",
      "}",
    ],
  },

  "Mongoose Model": {
    "prefix": "model",
    "description": "Cria Mongoose Schema e Model",
    "body": [
      "import { I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import mongoose, { Schema } from 'mongoose';",
      "",
      "const schema: Schema = new Schema(",
      "  {",
      "    ${3:name}: { type: String, required: true },",
      "    ${4:description}: { type: String },",
      "    created_by: { type: String },",
      "    updated_by: { type: String },",
      "  },",
      "  {",
      "    timestamps: true,",
      "  },",
      ");",
      "",
      "export const ${1:Resource} = mongoose.model<I${1:Resource}Document>('${1:Resource}', schema);",
    ],
  },

  "Create Service": {
    "prefix": "service-create",
    "description": "Cria serviço de criação (Create)",
    "body": [
      "import { injectable, inject } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { I${1:Resource}DTO, I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import { IServiceResponse } from '@shared/types/global';",
      "",
      "@injectable()",
      "export default class CreateService {",
      "  constructor(",
      "    @inject('${1:Resource}Repository')",
      "    private repository: I${1:Resource}Repository,",
      "  ) {}",
      "",
      "  public async execute(",
      "    data: I${1:Resource}DTO,",
      "    userEmail: string | undefined,",
      "  ): Promise<IServiceResponse<I${1:Resource}Document>> {",
      "    const created = await this.repository.create({",
      "      ...data,",
      "      created_by: userEmail,",
      "    });",
      "",
      "    return {",
      "      success: true,",
      "      message: '${1:Resource} criado com sucesso!',",
      "      data: created,",
      "    };",
      "  }",
      "}",
    ],
  },

  "Update Service": {
    "prefix": "service-update",
    "description": "Cria serviço de atualização (Update)",
    "body": [
      "import { injectable, inject } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { I${1:Resource}DTO, I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import { IServiceResponse } from '@shared/types/global';",
      "import { NotFoundError } from '@shared/errors/AppError';",
      "",
      "@injectable()",
      "export default class UpdateService {",
      "  constructor(",
      "    @inject('${1:Resource}Repository')",
      "    private repository: I${1:Resource}Repository,",
      "  ) {}",
      "",
      "  public async execute(",
      "    id: string,",
      "    data: Partial<I${1:Resource}DTO>,",
      "    userEmail: string | undefined,",
      "  ): Promise<IServiceResponse<I${1:Resource}Document>> {",
      "    const exist = await this.repository.findById(id);",
      "    if (!exist) {",
      "      throw new NotFoundError({ message: '${1:Resource} não encontrado' });",
      "    }",
      "",
      "    const updated = await this.repository.update(id, {",
      "      ...data,",
      "      updated_by: userEmail,",
      "    });",
      "",
      "    return {",
      "      success: true,",
      "      message: '${1:Resource} atualizado com sucesso!',",
      "      data: updated!,",
      "    };",
      "  }",
      "}",
    ],
  },

  "Delete Service": {
    "prefix": "service-delete",
    "description": "Cria serviço de remoção (Delete)",
    "body": [
      "import { injectable, inject } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { IServiceResponse } from '@shared/types/global';",
      "import { NotFoundError } from '@shared/errors/AppError';",
      "",
      "@injectable()",
      "export default class DeleteService {",
      "  constructor(",
      "    @inject('${1:Resource}Repository')",
      "    private repository: I${1:Resource}Repository,",
      "  ) {}",
      "",
      "  public async execute(id: string): Promise<IServiceResponse<{ id: string }>> {",
      "    const deleted = await this.repository.delete(id);",
      "    if (!deleted) {",
      "      throw new NotFoundError({ message: '${1:Resource} não encontrado' });",
      "    }",
      "",
      "    return {",
      "      success: true,",
      "      message: '${1:Resource} deletado com sucesso!',",
      "      data: { id: deleted.id },",
      "    };",
      "  }",
      "}",
    ],
  },

  "FindAll Service": {
    "prefix": "service-findall",
    "description": "Cria serviço FindAll com paginação",
    "body": [
      "import { injectable, inject } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import { IPaginatedResult } from '@shared/utils/pagination';",
      "import { applyPaginationParams, buildPaginatedResult } from '@shared/utils/pagination';",
      "import { applySearchParam } from '@shared/utils/search';",
      "",
      "@injectable()",
      "export default class FindAllService {",
      "  constructor(",
      "    @inject('${1:Resource}Repository')",
      "    private repository: I${1:Resource}Repository,",
      "  ) {}",
      "",
      "  public async execute(",
      "    query: Record<string, any>,",
      "  ): Promise<IPaginatedResult<I${1:Resource}Document>> {",
      "    let queryParams: Record<string, any> = {};",
      "",
      "    // Aplica busca textual",
      "    queryParams = applySearchParam(query, queryParams, {",
      "      textFields: ['${3:name}', '${4:description}'],",
      "    });",
      "",
      "    // Aplica paginação",
      "    queryParams = applyPaginationParams(query, queryParams);",
      "",
      "    const [total, data] = await Promise.all([",
      "      this.repository.total(queryParams),",
      "      this.repository.findAll(queryParams),",
      "    ]);",
      "",
      "    return buildPaginatedResult(data, total, query);",
      "  }",
      "}",
    ],
  },

  "FindById Service": {
    "prefix": "service-findbyid",
    "description": "Cria serviço FindById",
    "body": [
      "import { injectable, inject } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import { I${1:Resource}Document } from '@modules/${2:moduleName}/dto/I${1:Resource}DTO';",
      "import { NotFoundError } from '@shared/errors/AppError';",
      "",
      "@injectable()",
      "export default class FindByIdService {",
      "  constructor(",
      "    @inject('${1:Resource}Repository')",
      "    private repository: I${1:Resource}Repository,",
      "  ) {}",
      "",
      "  public async execute(id: string): Promise<I${1:Resource}Document> {",
      "    const exist = await this.repository.findById(id);",
      "    if (!exist) {",
      "      throw new NotFoundError({ message: '${1:Resource} não encontrado' });",
      "    }",
      "    return exist;",
      "  }",
      "}",
    ],
  },

  "CRUD Controller": {
    "prefix": "controller-crud",
    "description": "Cria Controller completo com CRUD",
    "body": [
      "import { Request, Response } from 'express';",
      "import { container } from 'tsyringe';",
      "",
      "import FindAllService from '@modules/${1:moduleName}/services/${2:resourceLower}/FindAllService';",
      "import CreateService from '@modules/${1:moduleName}/services/${2:resourceLower}/CreateService';",
      "import DeleteService from '@modules/${1:moduleName}/services/${2:resourceLower}/DeleteService';",
      "import FindByIdService from '@modules/${1:moduleName}/services/${2:resourceLower}/FindByIdService';",
      "import UpdateService from '@modules/${1:moduleName}/services/${2:resourceLower}/UpdateService';",
      "",
      "export default class ${3:Resource}Controller {",
      "  public async findAll(req: Request, res: Response): Promise<Response> {",
      "    const service = container.resolve(FindAllService);",
      "    const result = await service.execute(req.query);",
      "    return res.json(result);",
      "  }",
      "",
      "  public async create(req: Request, res: Response): Promise<Response> {",
      "    const service = container.resolve(CreateService);",
      "    const result = await service.execute(req.body, req.userEmail);",
      "    return res.json(result);",
      "  }",
      "",
      "  public async findById(req: Request, res: Response): Promise<Response> {",
      "    const service = container.resolve(FindByIdService);",
      "    const result = await service.execute(req.params.id);",
      "    return res.json(result);",
      "  }",
      "",
      "  public async update(req: Request, res: Response): Promise<Response> {",
      "    const service = container.resolve(UpdateService);",
      "    const result = await service.execute(req.params.id, req.body, req.userEmail);",
      "    return res.json(result);",
      "  }",
      "",
      "  public async delete(req: Request, res: Response): Promise<Response> {",
      "    const service = container.resolve(DeleteService);",
      "    const result = await service.execute(req.params.id);",
      "    return res.json(result);",
      "  }",
      "}",
    ],
  },

  "CRUD Routes": {
    "prefix": "routes-crud",
    "description": "Cria Router completo com CRUD",
    "body": [
      "import { Router } from 'express';",
      "import ${1:Resource}Controller from '@modules/${2:moduleName}/infra/https/controllers/${1:Resource}Controller';",
      "import middleware from '@modules/users/infra/https/middleware';",
      "",
      "const router = Router();",
      "const controller = new ${1:Resource}Controller();",
      "",
      "router.use((req, res, next) => {",
      "  res.header(",
      "    'Access-Control-Allow-Headers',",
      "    'x-access-token, Origin, Content-Type, Accept',",
      "  );",
      "  next();",
      "});",
      "",
      "router.post('/', [middleware.authJwt.verifyToken], controller.create);",
      "router.get('/', [middleware.authJwt.verifyToken], controller.findAll);",
      "router.get('/:id', [middleware.authJwt.verifyToken], controller.findById);",
      "router.put('/:id', [middleware.authJwt.verifyToken], controller.update);",
      "router.delete('/:id', [middleware.authJwt.verifyToken], controller.delete);",
      "",
      "export default router;",
    ],
  },

  "Container DI Registration": {
    "prefix": "container-di",
    "description": "Cria registro de container DI",
    "body": [
      "import { container } from 'tsyringe';",
      "import I${1:Resource}Repository from '@modules/${2:moduleName}/repositories/I${1:Resource}Repository';",
      "import ${1:Resource}Repository from '@modules/${2:moduleName}/infra/mongo/repositories/${1:Resource}Repository';",
      "",
      "container.registerSingleton<I${1:Resource}Repository>(",
      "  '${1:Resource}Repository',",
      "  ${1:Resource}Repository,",
      ");",
    ],
  },
}
