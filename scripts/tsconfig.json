{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "../dist/scripts",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
